@echo off
:: Устанавливаем кодировку консоли Windows для корректного русского языка
chcp 866 > nul

echo ==========================================================
echo ?? ФИKСАЦИЯ ТОЧKИ СОХРАНЕНИЯ КИЦУНЭ В ОБЛАKО
echo ==========================================================

:: Автоматически вытягиваем текущую дату и время с компьютера
set current_date=%date%
set current_time=%time:~0,8%
set point_name=Backup_%current_date%_%current_time%

echo [1/3] Сканирование измененных файлов в Notepad++...
git add .

echo [2/3] Создание локальной точки сохранения: %point_name%...
git commit -m "%point_name%"

echo [3/3] Отправка безопасного бэкапа на твой приватный GitHub...
git push origin main

echo ==========================================================
echo ? УСПЕХ! Точка '%point_name%' надежно заперта в истории.
echo ==========================================================
pause
