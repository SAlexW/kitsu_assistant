@echo off
chcp 866 > nul

echo ==========================================================
echo ? ЗАПУСK ИНТЕРТИВНОГО ОТKАТА «МАШИНЫ ВРЕМЕНИ»
echo ==========================================================

:: Выводим последние 7 точек сохранения в красивом пронумерованном формате
echo Список доступных точек возврата в системе:
echo ----------------------------------------------------------
git log --oneline -n 7 --pretty=format:"%%h - %%s"
echo.
echo ----------------------------------------------------------
echo ??  ВНИМАНИЕ: Откат сотрет все текущие несохраненные правки!
echo Для отмены просто закрой это окно крестиком.
echo ----------------------------------------------------------

:: Запрашиваем у пользователя хэш-код коммита (первые 7 символов строки)
set /p commit_hash="Введи короткий код (например, 7a2b3c) нужной точки: "

if "%commit_hash%"=="" (
    echo ? Ошибка: Код не введен. Отмена операции.
    goto end
)

echo.
echo Запуск молекулярного отката файлов к точке %commit_hash%...
git reset --hard %commit_hash%

echo.
echo ==========================================================
echo ? ГОТОВО! Папка проекта успешно возвращена в прошлое!
echo ==========================================================

:end
pause
